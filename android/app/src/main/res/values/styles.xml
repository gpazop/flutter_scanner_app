<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SgaLaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/sga_launch_blue</item>
        <item name="android:navigationBarColor">@color/sga_launch_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="LaunchTheme" parent="@style/SgaLaunchTheme" />

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/sga_launch_blue</item>
    </style>
</resources>
